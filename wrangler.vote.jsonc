{
  // Publieke stem-Worker (zonder Cloudflare Access). Gebruikt de sessiekamers van de hoofd-Worker.
  // Eerst "vakantieman" deployen, daarna deze Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vakantieman-vote",
  "main": "src/vote/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/vote",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "SessionRoom", "script_name": "vakantieman" }]
  },
  "observability": { "enabled": true }
}
